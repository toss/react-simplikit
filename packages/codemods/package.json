{
  "name": "@react-simplikit/codemods",
  "version": "0.4.1",
  "description": "Codemods for react-simplikit.",
  "type": "module",
  "bin": "./dist/bin/codemods.cjs",
  "keywords": [
    "react-simplikit",
    "codemods"
  ],
  "homepage": "https://react-simplikit.slash.page",
  "bugs": "https://github.com/toss/react-simplikit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toss/react-simplikit.git",
    "directory": "packages/codemods"
  },
  "license": "MIT",
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "yarn build",
    "clean": "rimraf ./dist",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "yarn build && vitest run -c vitest.e2e.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "execa": "^5.1.1",
    "jscodeshift": "^17.3.0",
    "prompts": "^2.4.2",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^24.13.3",
    "@types/prompts": "^2.4.9",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^2.1.8",
    "detect-indent": "^7.0.2",
    "eslint": "^9.39.3",
    "fast-check": "^4.9.0",
    "rimraf": "^6.0.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
