{
  "name": "react-simplikit",
  "version": "0.0.46",
  "description": "Lightweight yet powerful library providing various utilities for React",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./esm/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "esm/**/*"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "hooks",
    "utilities",
    "components"
  ],
  "homepage": "https://react-simplikit.slash.page",
  "bugs": "https://github.com/toss/react-simplikit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toss/react-simplikit.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "clean": "rimraf ./dist ./esm",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
