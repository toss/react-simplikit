{
  "name": "@react-simplikit/codemod",
  "version": "0.0.0",
  "private": true,
  "description": "Codemods for upgrading react-simplikit, run with the Codemod CLI",
  "type": "module",
  "bin": {
    "react-simplikit-codemod": "./cli.mjs"
  },
  "keywords": [
    "react-simplikit",
    "codemod",
    "migration",
    "upgrade"
  ],
  "homepage": "https://react-simplikit.slash.page",
  "bugs": "https://github.com/toss/react-simplikit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toss/react-simplikit.git",
    "directory": "codemods"
  },
  "license": "MIT",
  "files": [
    "cli.mjs",
    "*/README.md",
    "*/workflow.yaml",
    "*/scripts",
    "*/utils"
  ],
  "preferUnplugged": true,
  "publishConfig": {
    "access": "public"
  }
}
